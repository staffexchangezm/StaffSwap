              "widgetType": "html",
              "settings": {
                "html": "<div class=\"landing-hero\" style=\"margin:0;width:100%;padding:0;background:none\"><div class=\"landing-hero__copy\"><p class=\"eyebrow\">WORKPLACE MOBILITY, MADE SIMPLE</p><h1>Workplace mobility, made simple</h1><p>Connect with professionals across Zambia looking to exchange work locations. Search available opportunities, create your swap request and explore relocation possibilities.</p><div class=\"hero-actions\"><a class=\"button button--primary\" href=\"/register/\">Sign Up Free</a><a class=\"button button--outline\" href=\"/swaps/\">Find Swaps</a></div><div class=\"benefits-row\"><div class=\"benefit-item\"><span class=\"benefit-icon\">\u2713</span><strong>Search by profession</strong></div><div class=\"benefit-item\"><span class=\"benefit-icon\">\u2713</span><strong>Review potential matches</strong></div><div class=\"benefit-item\"><span class=\"benefit-icon\">\u2713</span><strong>Protect your privacy</strong></div></div></div><div class=\"swap-visual\"><div class=\"swap-node swap-node--from\"><div class=\"swap-avatar\">LM</div><strong>Lusaka</strong><small>Current workplace</small></div><div class=\"swap-connector\"><b>&harr;</b><small>Current \u2192 Desired</small></div><div class=\"swap-node swap-node--to\"><div class=\"swap-avatar swap-avatar--blue\">BM</div><strong>Ndola</strong><small>Preferred location</small></div></div></div>"
              },
